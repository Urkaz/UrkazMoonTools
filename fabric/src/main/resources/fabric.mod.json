{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
	"junshengxie - Simplified Chinese localization"
  ],
  "contact": {
    "sources": "https://github.com/Urkaz/UrkazMoonTools",
    "issues": "https://github.com/Urkaz/UrkazMoonTools/issues"
  },

  "license": "${mod_license}",
  "icon": "${mod_icon}",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.urkaz.moontools.fabric.UrkazMoonToolsFabric"
    ],
    "client": [
      "com.urkaz.moontools.fabric.client.UrkazMoonToolsFabricClient"
    ],
    "modmenu": [
      "com.urkaz.moontools.fabric.client.UrkazMoonToolsModMenu"
    ]
  },
  "mixins": [
    "urkazmoontools.mixins.json",
    "urkazmoontools-common.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": ">=${mc_version}",
    "architectury": ">=${architectury_version}"
  }
}
